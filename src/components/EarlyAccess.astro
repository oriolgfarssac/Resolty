---
import Icon from './Icon.astro';
import { copy, pathFor, spending, tools, type Locale } from '../lib/i18n';
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang];
const f = t.form;
---
<section class="early" id="early-access" aria-labelledby="early-title">
  <div class="wrap early-inner">
    <div class="early-copy">
      <p class="eyebrow">{t.early.label}</p><h2 id="early-title">{t.early.title}</h2><p>{t.early.body}</p>
      <ul>{t.early.points.map((item) => <li><Icon name="check" />{item}</li>)}</ul>
    </div>
    <div class="form-panel">
      <form method="post" action="/api/early-access/" data-lang={lang} data-messages={JSON.stringify({ cta: t.cta, form: { invalid: f.invalid, sending: f.sending, unavailable: f.unavailable } })} data-waitlist>
        <input type="hidden" name="locale" value={lang} />
        <div hidden><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="fields">
          <label>{f.name}<input name="name" autocomplete="name" required minlength="2" maxlength="120" /></label>
          <label>{f.email}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
          <label>{f.company}<input name="company" autocomplete="organization" required minlength="2" maxlength="160" /></label>
          <label>{f.spend}<select name="spend" required><option value="" disabled selected>{f.choose}</option>
            {spending.map((item, i) => <option value={item}>{f.ranges[i]}</option>)}
          </select></label>
        </div>
        <fieldset><legend>{f.tools} <small>({f.optional})</small></legend>
          <div class="chips">{tools.map((item, i) => <label><input type="checkbox" name="tools" value={item} /><span>{f.toolChoices[i - 4] ?? item}</span></label>)}</div>
        </fieldset>
        <label>{f.use} <small>({f.optional})</small><textarea name="use" rows="2" maxlength="500"></textarea></label>
        <label class="consent"><input type="checkbox" name="consent" value="yes" required /><span>{f.consent} <a href={pathFor(lang) + 'privacy/'}>{t.privacy}</a>.</span></label>
        <p class="form-error" tabindex="-1" role="alert" hidden></p>
        <button class="button" type="submit"><span>{t.cta}</span><Icon name="arrow" /></button>
      </form>
      <div class="success" hidden tabindex="-1">
        <span class="tile-icon"><Icon name="check" /></span><h3>{f.success}</h3><p>{f.successBody}</p>
      </div>
    </div>
  </div>
</section>
<script>
  import { track } from '../scripts/analytics';


  const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
  if (form?.dataset.lang) {
    const lang = form.dataset.lang;
    const t = JSON.parse(form.dataset.messages!) as { cta: string; form: { invalid: string; sending: string; unavailable: string } };
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = button.querySelector('span')!;
    const error = form.querySelector<HTMLElement>('.form-error')!;
    const success = form.parentElement!.querySelector<HTMLElement>('.success')!;

    form.addEventListener('input', () => track('form_start', lang), { once: true });
    form.addEventListener('input', (event) => {
      const input = event.target;
      if (input instanceof HTMLInputElement && input.name === 'tools' && input.checked) {
        form.querySelectorAll<HTMLInputElement>('input[name="tools"]').forEach((choice) => {
          if (choice !== input && (input.value === 'none' || choice.value === 'none')) choice.checked = false;
        });
      }
    });
    form.addEventListener('invalid', (event) => {
      const field = event.target;
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
        field.setAttribute('aria-invalid', 'true');
        error.textContent = t.form.invalid;
        error.hidden = false;
      }
    }, true);
    form.addEventListener('input', (event) => {
      if (event.target instanceof HTMLElement) event.target.removeAttribute('aria-invalid');
      error.hidden = true;
    });
    form.noValidate = true;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      if (!form.checkValidity()) {
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      label.textContent = t.form.sending;
      error.hidden = true;
      try {
        const body = new URLSearchParams();
        for (const [key, value] of new FormData(form)) {
          if (typeof value === 'string') body.append(key, value);
        }
        const response = await fetch(form.action, { method: 'POST', body, headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (response.ok && result.ok === true) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        error.textContent = typeof result.message === 'string' ? result.message : t.form.unavailable;
      } catch {
        error.textContent = t.form.unavailable;
      } finally {
        form.removeAttribute('aria-busy');
        button.disabled = false;
        label.textContent = t.cta;
      }
      error.hidden = false;
      error.focus();
    });
  }
</script>
